<Window x:Class="Verity.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:infra="clr-namespace:Verity.Desktop.Infrastructure" Title="Verity Face Attendance" Width="1440" Height="900" MinWidth="1100" MinHeight="700" WindowStartupLocation="CenterScreen" WindowState="Maximized" Background="#F3F6F2">
 <Window.Resources>
  <infra:PageVisibilityConverter x:Key="PageVisible"/><infra:Base64ImageConverter x:Key="Base64Image"/><BooleanToVisibilityConverter x:Key="BoolVisible"/><SolidColorBrush x:Key="Ink" Color="#17342D"/><SolidColorBrush x:Key="Lime" Color="#D6F46B"/>
  <Style TargetType="Button"><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="14,9"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style x:Key="Nav" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#AFC1BA"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,3"/><Setter Property="Padding" Value="14,12"/></Style>
  <Style x:Key="Primary" TargetType="Button"><Setter Property="Background" Value="{StaticResource Ink}"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="11"/><Setter Property="BorderBrush" Value="#D8E4DD"/><Setter Property="Margin" Value="0,6,0,16"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DFE8E2"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,14,14"/></Style>
 </Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#122923"><DockPanel Margin="18,26"><StackPanel DockPanel.Dock="Top">
   <StackPanel Orientation="Horizontal" Margin="8,0,0,35"><Border Background="{StaticResource Lime}" CornerRadius="8" Width="34" Height="34"><TextBlock Text="V" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,0"><TextBlock Text="verity" Foreground="White" FontSize="20" FontWeight="Bold"/><TextBlock Text="FACE ATTENDANCE" Foreground="#7F9C93" FontSize="9"/></StackPanel></StackPanel>
   <TextBlock Text="WORKSPACE" Foreground="#668079" FontSize="10" Margin="12,0,0,8"/>
   <Button Style="{StaticResource Nav}" Content="▦   Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/><Button Style="{StaticResource Nav}" Content="◉   Live Monitor" Command="{Binding NavigateCommand}" CommandParameter="Live Monitor"/><Button Style="{StaticResource Nav}" Content="♙   People" Command="{Binding NavigateCommand}" CommandParameter="People"/><Button Style="{StaticResource Nav}" Content="＋   Register Person" Command="{Binding NavigateCommand}" CommandParameter="Register"/><Button Style="{StaticResource Nav}" Content="≡   Events" Command="{Binding NavigateCommand}" CommandParameter="Events"/><TextBlock Text="SYSTEM" Foreground="#668079" FontSize="10" Margin="12,28,0,8"/><Button Style="{StaticResource Nav}" Content="⚙   Settings" Command="{Binding NavigateCommand}" CommandParameter="Settings"/>
  </StackPanel><Border DockPanel.Dock="Bottom" Background="#1D3B33" CornerRadius="10" Padding="12"><StackPanel><TextBlock Text="SYSTEM HEALTH" Foreground="#8CA49C" FontSize="9"/><TextBlock Text="{Binding Status}" Foreground="White" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border></DockPanel></Border>
  <Grid Grid.Column="1" Margin="38,30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,24"><TextBlock Text="{Binding Page}" FontSize="29" FontWeight="Bold" Foreground="{StaticResource Ink}"/><Button Content="Refresh" Command="{Binding RefreshCommand}" HorizontalAlignment="Right"/></Grid>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><Grid>
    <StackPanel Visibility="{Binding Page,Converter={StaticResource PageVisible},ConverterParameter=Dashboard}"><Border Background="#214B3F" CornerRadius="16" Padding="36" Margin="0,0,0,18"><StackPanel><TextBlock Text="CONTINUOUS ACCESS INTELLIGENCE" Foreground="#9AB9AE"/><TextBlock Text="Know who enters. React when they should not." Foreground="White" FontSize="34" FontWeight="SemiBold" Margin="0,10,0,14"/><TextBlock Text="Webcam and RTSP recognition with local biometric processing." Foreground="#B9CCC4"/><Button Style="{StaticResource Primary}" Background="{StaticResource Lime}" Foreground="#17342D" Content="Open live monitor" Width="160" HorizontalAlignment="Left" Margin="0,20,0,0" Command="{Binding NavigateCommand}" CommandParameter="Live Monitor"/></StackPanel></Border><UniformGrid Columns="4"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="REGISTERED"/><TextBlock Text="{Binding People.Count}" FontSize="32" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="EVENTS"/><TextBlock Text="{Binding Events.Count}" FontSize="32" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="MODEL"/><TextBlock Text="ArcFace" FontSize="22" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource Card}"><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/></Border></UniformGrid></StackPanel>
    <Grid Visibility="{Binding Page,Converter={StaticResource PageVisible},ConverterParameter=Live Monitor}"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Background="#10251F" CornerRadius="16" MinHeight="520" Margin="0,0,20,0" ClipToBounds="True"><Grid>
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="◎" Foreground="{StaticResource Lime}" FontSize="70" HorizontalAlignment="Center"/><TextBlock Text="Continuous recognition monitor" Foreground="White" FontSize="24"/><TextBlock Text="Start monitoring, then select Display camera." Foreground="#9FB5AC" Margin="0,10,0,22"/></StackPanel>
      <Image Source="{Binding MonitorPreview}" Stretch="UniformToFill" Visibility="{Binding DisplayMonitor,Converter={StaticResource BoolVisible}}"/>
      <Border Background="#CC10251F" VerticalAlignment="Bottom" Padding="18"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Style="{StaticResource Primary}" Content="Start monitoring" Command="{Binding StartMonitorCommand}" Margin="0,0,10,0"/><Button Content="{Binding DisplayButtonText}" Command="{Binding ToggleDisplayCommand}" Margin="0,0,10,0"/><Button Content="Stop" Command="{Binding StopMonitorCommand}"/></StackPanel></Border>
     </Grid></Border>
     <StackPanel Grid.Column="1"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="LATEST DETECTION"/><TextBlock Text="{Binding LatestEvent.DisplayName,TargetNullValue=Waiting for a face…}" FontSize="22" FontWeight="Bold" Margin="0,8"/><TextBlock Text="{Binding LatestEvent.Result}"/><TextBlock Text="{Binding LatestEvent.Confidence,StringFormat={}{0:F1}% confidence}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="PROCESSING DEVICE" FontWeight="Bold"/><TextBlock Text="{Binding ActiveProcessor,StringFormat=Active: {0}}" Foreground="#587069" Margin="0,6,0,12"/><UniformGrid Columns="2"><Button Content="Use CPU" Command="{Binding UseCpuCommand}" Margin="0,0,5,0"/><Button Style="{StaticResource Primary}" Content="Use GPU" Command="{Binding UseGpuCommand}" Margin="5,0,0,0"/></UniformGrid><TextBlock Text="GPU uses DirectML when supported." Foreground="#75877F" FontSize="11" Margin="0,10,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><CheckBox Content="Use RTSP instead of webcam" IsChecked="{Binding UseRtsp}"/><TextBlock Text="RTSP URL"/><TextBox Text="{Binding RtspUrl}"/></StackPanel></Border></StackPanel>
    </Grid>
    <Grid Visibility="{Binding Page,Converter={StaticResource PageVisible},ConverterParameter=Register}"><Grid.ColumnDefinitions><ColumnDefinition Width=".9*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,12,34,0"><TextBlock Text="Register an employee" FontSize="34" FontWeight="Bold"/><TextBlock Text="Capture three guided angles for a stronger identity template." TextWrapping="Wrap" Margin="0,10,0,18"/>
      <Border Background="#10251F" CornerRadius="16" Height="390" ClipToBounds="True">
       <Grid><TextBlock Text="Camera preview appears here" Foreground="#789087" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Image Source="{Binding EnrollmentPreview}" Stretch="UniformToFill"/>
        <Grid Visibility="{Binding EnrollmentActive,Converter={StaticResource BoolVisible}}">
         <Ellipse Width="230" Height="300" Stroke="{StaticResource Lime}" StrokeThickness="3" StrokeDashArray="5 3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
         <Border Background="#D9142923" CornerRadius="14" Padding="18,10" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,18,0,0">
          <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding EnrollmentArrow}" Foreground="{StaticResource Lime}" FontSize="34" FontWeight="Bold" Margin="0,0,12,0"><TextBlock.RenderTransform><ScaleTransform CenterX=".5" CenterY=".5"/></TextBlock.RenderTransform><TextBlock.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever" AutoReverse="True"><DoubleAnimation Storyboard.TargetProperty="Opacity" From=".45" To="1" Duration="0:0:0.55"/><DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" From=".85" To="1.15" Duration="0:0:0.55"/><DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" From=".85" To="1.15" Duration="0:0:0.55"/></Storyboard></BeginStoryboard></EventTrigger></TextBlock.Triggers></TextBlock><StackPanel><TextBlock Text="{Binding EnrollmentPose,StringFormat=LOOK {0}}" Foreground="White" FontWeight="Bold" FontSize="15" TextOptions.TextFormattingMode="Display"/><TextBlock Text="{Binding EnrollmentInstruction}" Foreground="#D8E8E1"/></StackPanel></StackPanel>
         </Border>
        </Grid>
       </Grid>
      </Border>
      <ProgressBar Value="{Binding EnrollmentProgress,Mode=OneWay}" Maximum="100" Height="8" Margin="0,14,0,8" Foreground="{StaticResource Lime}" Background="#DCE6E1"/>
      <TextBlock Text="{Binding EnrollmentCaptured,StringFormat={}{0} of 3 poses captured}" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
     </StackPanel>
     <Border Grid.Column="1" Style="{StaticResource Card}" Padding="28"><StackPanel><TextBlock Text="Full name"/><TextBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Employee ID"/><TextBox Text="{Binding EmployeeId,UpdateSourceTrigger=PropertyChanged}"/><Button Content="Save details only" Command="{Binding SavePersonCommand}" Margin="0,8,0,10"/><TextBlock Text="Face image"/><DockPanel Margin="0,6,0,8"><Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseImageCommand}"/><TextBox Text="{Binding SelectedImage}" IsReadOnly="True" Margin="0,0,8,0"/></DockPanel><CheckBox Content="I have consent to store biometric templates" IsChecked="{Binding Consent}" Margin="0,8,0,18"/><Button Style="{StaticResource Primary}" Content="Validate uploaded image and save face" Command="{Binding RegisterCommand}"/><Button Content="Start guided three-pose capture / retake" Command="{Binding GuidedEnrollmentCommand}" Margin="0,10,0,0"/><Border Background="#F0F5F2" CornerRadius="8" Padding="14" Margin="0,18,0,0"><StackPanel><TextBlock Text="CAPTURE SEQUENCE" Foreground="#678078" FontSize="10" FontWeight="Bold"/><TextBlock Text="◎  Center   ←  Left   →  Right" FontSize="15" Margin="0,8,0,0" TextWrapping="Wrap"/><TextBlock Text="Move slowly and hold each position until it is captured automatically." Foreground="#61716B" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border></StackPanel></Border>
    </Grid>
    <DataGrid Visibility="{Binding Page,Converter={StaticResource PageVisible},ConverterParameter=People}" ItemsSource="{Binding People}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="82" HeadersVisibility="Column" GridLinesVisibility="Horizontal"><DataGrid.Columns><DataGridTemplateColumn Header="Photo" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Width="64" Height="64" CornerRadius="32" Background="#DCE7E1" ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="{Binding ImageData,Converter={StaticResource Base64Image}}" Stretch="UniformToFill"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Employee ID" Binding="{Binding EmployeeId}" Width="150"/><DataGridTextColumn Header="Templates" Binding="{Binding TemplateCount}" Width="90"/><DataGridTextColumn Header="Created" Binding="{Binding CreatedAt}" Width="180"/><DataGridTemplateColumn Header="Actions" Width="220"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Edit" Padding="14,7" Margin="0,0,6,0" Command="{Binding DataContext.EditPersonCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/><Button Content="Retake" Padding="14,7" Margin="0,0,6,0" Command="{Binding DataContext.RetakePersonCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/><Button Content="Delete" Padding="14,7" Foreground="#A32626" Command="{Binding DataContext.DeletePersonCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
    <DataGrid Visibility="{Binding Page,Converter={StaticResource PageVisible},ConverterParameter=Events}" ItemsSource="{Binding Events}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="190"/><DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="120"/><DataGridTextColumn Header="Person" Binding="{Binding DisplayName}" Width="*"/><DataGridTextColumn Header="Confidence" Binding="{Binding Confidence,StringFormat={}{0:F1}%}" Width="120"/><DataGridTextColumn Header="Camera" Binding="{Binding Camera}" Width="150"/></DataGrid.Columns></DataGrid>
    <Border Visibility="{Binding Page,Converter={StaticResource PageVisible},ConverterParameter=Settings}" Style="{StaticResource Card}" MaxWidth="700" HorizontalAlignment="Left"><StackPanel><TextBlock Text="Experiment settings" FontSize="25" FontWeight="Bold"/><TextBlock Text="Webcam 0 · 1280×720 · 5 FPS" Margin="0,14,0,6"/><TextBlock Text="Threshold 0.48 · attendance 10 min · alerts 15 sec · retention 30 days"/><TextBlock Text="Use Windows DPAPI for RTSP credentials before production." Foreground="#9A5A4F" Margin="0,18,0,0"/></StackPanel></Border>
   </Grid></ScrollViewer>
  </Grid>
 </Grid>
</Window>
